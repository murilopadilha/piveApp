{
  "expo": {
    "name": "PIVEapp",
    "slug": "piveapp",
    "version": "1.0.0",
    "scheme": "bovina",
    "orientation": "portrait",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
